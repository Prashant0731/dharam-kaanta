# App
APP_NAME=Dharam Kaanta API
DEBUG=True
API_V1_PREFIX=/api/v1

# Database (PostgreSQL/Supabase)
# For local PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/dharam_kaanta

# For Supabase (replace with your project details):
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Supabase (optional - for direct client usage)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=[YOUR_ANON_KEY]
SUPABASE_SERVICE_KEY=[YOUR_SERVICE_ROLE_KEY]

# CORS
ALLOWED_ORIGINS=["http://localhost:5173", "https://your-github-pages-url.github.io"]